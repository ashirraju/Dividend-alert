PORT=3000
NSE_RSS_URL=https://nsearchives.nseindia.com/content/RSS/Corporate_action.xml
POLL_INTERVAL_MS=300000

# Telegram Bot Notifications (Same setup as global-trader-news)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_chat_id_or_channel_id
TIME_ZONE=Asia/Kolkata
DRY_RUN=false

# Dividend Yield Filter: only notify users if (divPerShare / ltp) * 100 > MIN_DIVIDEND_YIELD
MIN_DIVIDEND_YIELD=3
